    CI: verify sandbox-tools artifacts against pinned digests in release gate
    
    slow-tool-tests-release now checks SHA256SUMS is in lockstep with the
    version bump and fetches + digest-checks all four artifacts (not just the
    amd64 pair the tests exercise); check-version-bump forbids sums-only
    changes (unbumped direction only, with a seeding carve-out).
    
    Co-authored-by: Eric Patey <769548+epatey@users.noreply.github.com>
    
    Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 04535f5ff..84c75e1aa 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -403,6 +403,21 @@ jobs:
             fi
           else
             if [ "$PR_VERSION" = "$BASE_VERSION" ]; then
+              # Unbumped direction of the digest-pinning rule: a SHA256SUMS-only
+              # change is a re-publication of an existing version, which is
+              # forbidden (published S3 objects are immutable). Applies only when
+              # the sums file exists on the base ref so the PR that seeds the
+              # file (no bump) doesn't fail the rule it introduces. The bumped
+              # direction (sums must be rewritten) is deliberately enforced only
+              # by slow-tool-tests-release: the sums are written at post-approval
+              # upload, and a red fast gate here would block slow-tool-tests-dev
+              # for the whole review window.
+              SUMS_PATH="src/inspect_ai/tool/_sandbox_tools_utils/SHA256SUMS"
+              if git cat-file -e "origin/${BASE_REF}:${SUMS_PATH}" 2>/dev/null && \
+                 ! git diff --quiet "origin/${BASE_REF}" -- "${SUMS_PATH}"; then
+                echo "::error::${SUMS_PATH} changed but ${VERSION_PATH} is unchanged. Digests for a published version are immutable; bump the version and publish fresh artifacts instead."
+                exit 1
+              fi
               echo "correctly_bumped=false" >> "$GITHUB_OUTPUT"
             else
               echo "::error::${VERSION_PATH} changed to v${PR_VERSION} but src/inspect_sandbox_tools/ is unchanged. Either revert the version change or include the injectable source change."
@@ -510,20 +525,50 @@ jobs:
           uv venv
           uv pip install .[dev]
 
-      - name: Fetch published non-dev sandbox-tools binaries (glibc + musl)
+      - name: Fetch and verify published non-dev sandbox-tools binaries
         run: |
           VERSION=$(tr -d '[:space:]' < src/inspect_ai/tool/_sandbox_tools_utils/sandbox_tools_version.txt)
+          SUMS=src/inspect_ai/tool/_sandbox_tools_utils/SHA256SUMS
           mkdir -p src/inspect_ai/binaries
-          # Both libc variants: the slow suite includes an Alpine (musl) case.
+          # Digest file must be in lockstep with the version bump: four non-blank
+          # entries, all named -v${VERSION}. (Entry format/distinctness is enforced
+          # by a fast unit test.) A flag records the failure rather than an early
+          # exit: `exit 1` in the awk body jumps to END, whose own exit would
+          # override the status.
+          if ! awk -v v="v${VERSION}" 'NF { n++; if ($2 !~ ("-" v "$")) bad = 1 } END { exit (bad || n != 4) }' "$SUMS"; then
+            echo "::error::${SUMS} is not updated for v${VERSION}. Build+upload the artifacts (upload_to_s3.py rewrites it) and commit it in this PR."
+            exit 1
+          fi
+          # All four artifacts are fetched and digest-checked, not just the amd64
+          # pair the slow tests exercise on this runner. Otherwise a crash partway
+          # through upload_to_s3.py's upload order (amd64 first) would leave the
+          # gate green with the arm64 objects missing, and the committed arm64
+          # digests would never be compared against S3 by anything but the
+          # maintainer-run round trip. The extra ~30 MB download is trivial in CI.
           for FILENAME in \
             "inspect-sandbox-tools-amd64-v${VERSION}" \
-            "inspect-sandbox-tools-amd64-musl-v${VERSION}"; do
+            "inspect-sandbox-tools-amd64-musl-v${VERSION}" \
+            "inspect-sandbox-tools-arm64-v${VERSION}" \
+            "inspect-sandbox-tools-arm64-musl-v${VERSION}"; do
             URL="https://inspect-sandbox-tools.s3.us-east-2.amazonaws.com/${FILENAME}"
+            # Keep today's explicit not-yet-uploaded error (a bare curl -f 404 is
+            # terse and carries no ::error annotation).
             if ! curl -fsI "$URL" >/dev/null; then
-              echo "::error::Published binary ${FILENAME} not found at ${URL}. Run: python src/inspect_ai/tool/_sandbox_tools_utils/upload_to_s3.py ${VERSION} then rerun this job."
+              echo "::error::Published binary ${FILENAME} not found at ${URL}. Run: python src/inspect_ai/tool/_sandbox_tools_utils/upload_to_s3.py ${VERSION}, commit the rewritten SHA256SUMS, then rerun this job."
               exit 1
             fi
             curl -fSL -o "src/inspect_ai/binaries/${FILENAME}" "$URL"
+            # Exactly-one-match assertion: without it, zero or duplicate entries
+            # feed sha256sum a malformed line and its "no properly formatted
+            # checksum lines" failure would be mislabeled a digest mismatch below.
+            DIGEST=$(awk -v f="$FILENAME" '$2 == f { print $1; n++ } END { exit n != 1 }' "$SUMS") || {
+              echo "::error::Expected exactly one ${SUMS} entry for ${FILENAME}; found none or duplicates (malformed sums file)."
+              exit 1
+            }
+            echo "${DIGEST}  src/inspect_ai/binaries/${FILENAME}" | sha256sum -c - || {
+              echo "::error::Digest mismatch for ${FILENAME}: the published S3 object does not match the digests committed in this PR. Do NOT re-upload over it. Investigate (wrong-checkout build, truncated upload, or tampering), and if the object is wrong, bump the version and publish fresh artifacts."
+              exit 1
+            }
             chmod +x "src/inspect_ai/binaries/${FILENAME}"
           done
 
